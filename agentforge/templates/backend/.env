# ==============================================================================
# {{ project_name }} - Local Development Environment Variables
# Auto-generated by AgentForge CLI Scaffolding
# ==============================================================================

# --- Project Configuration ---
PROJECT_NAME="{{ project_name }}"
ENVIRONMENT=dev
HOST=0.0.0.0
PORT=8000
DEBUG=false

# --- LLM Provider Choice ---
# Supported options: openai, anthropic, gemini, bedrock
LLM_PROVIDER=openai
LLM_TIMEOUT=60.0
LLM_MAX_RETRIES=3

# --- LLM Provider API Keys & Models ---
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o

# Google Gemini
GOOGLE_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-pro

# Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL_NAME=claude-3-5-sonnet-20240620

# AWS Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
AWS_REGION=ap-northeast-2

# --- Database & Storage ---
DATABASE_DRIVER=postgresql+asyncpg
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_DBNAME={{ project_name_snake }}
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgrespassword
DATABASE_SCHEMA=public
DATABASE_AUTO_MIGRATE=true
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=1800
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_PRE_PING=true
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/{{ project_name_snake }}

# --- Redis Cache & Session ---
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s %(levelname)s [%(name)s] %(message)s"

# --- Security & Authentication ---
JWT_SECRET_KEY={{ project_name }}-secret-key-super-secure-change-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Multi-protocol Auth (Optional: LDAP & SAML) ---
LDAP_ENABLED=false
LDAP_SERVER_URI=ldap://127.0.0.1:389
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_BASE=ou=users,dc=example,dc=com

SAML_ENABLED=false
SAML_SP_ENTITY_ID=https://localhost:8000/sp
SAML_ACS_URL=https://localhost:8000/api/v1/sso/acs

# --- MCP Server Configuration (Optional) ---
AX_MCP_SERVER_URL=http://127.0.0.1:8080/mcp
AX_MCP_SERVER_API_KEY=dummy_mcp_key
AX_MCP_SERVER_NAME=agentforge-mcp

# --- Langfuse Tracing (Optional) ---
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-placeholder
LANGFUSE_SECRET_KEY=sk-lf-placeholder
LANGFUSE_BASE_URL=http://localhost:3000
