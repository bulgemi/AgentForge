# ==============================================================================
# {{ project_name }} - Environment Variables Sample (.env.sample)
# Copy this file to .env and configure your local or deployment secrets.
#   $ cp .env.sample .env
# ==============================================================================

# --- Project Configuration ---
PROJECT_NAME="{{ project_name }}"
ENVIRONMENT=dev
HOST=0.0.0.0
PORT=8000
DEBUG=false

# --- LLM Provider Choice ---
# Supported providers: openai, anthropic, gemini, bedrock
LLM_PROVIDER=openai
LLM_TIMEOUT=60.0
LLM_MAX_RETRIES=3

# --- 1. OpenAI Settings ---
# When LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL_NAME=gpt-4o

# --- 2. Google Gemini Settings ---
# When LLM_PROVIDER=gemini
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_NAME=gemini-2.5-pro

# --- 3. Anthropic Claude Settings ---
# When LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL_NAME=claude-3-5-sonnet-20240620

# --- 4. AWS Bedrock Settings ---
# When LLM_PROVIDER=bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
AWS_REGION=ap-northeast-2
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# --- Database & Storage ---
DATABASE_DRIVER=postgresql+asyncpg
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_DBNAME={{ project_name_snake }}
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgrespassword
DATABASE_SCHEMA=public
DATABASE_AUTO_MIGRATE=true
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=1800
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_PRE_PING=true

# Direct database connection URL (overrides individual components above if specified)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/{{ project_name_snake }}

# --- Redis Cache & Session ---
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password
REDIS_DB=0
REDIS_SSL=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s %(levelname)s [%(name)s] %(message)s"

# --- Security & Authentication ---
# In production, use a secure random key of at least 32 characters
JWT_SECRET_KEY={{ project_name }}-secret-key-super-secure-change-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Multi-protocol Authentication (Optional) ---
# LDAP Authentication
LDAP_ENABLED=false
LDAP_SERVER_URI=ldap://127.0.0.1:389
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=adminpassword
LDAP_USER_BASE=ou=users,dc=example,dc=com

# SAML 2.0 Single Sign-On
SAML_ENABLED=false
SAML_SP_ENTITY_ID=https://localhost:8000/sp
SAML_ACS_URL=https://localhost:8000/api/v1/sso/acs

# --- MCP Server Configuration (Optional) ---
# Model Context Protocol (MCP) remote tool server
AX_MCP_SERVER_URL=http://127.0.0.1:8080/mcp
AX_MCP_SERVER_API_KEY=dummy_mcp_key
AX_MCP_SERVER_NAME=agentforge-mcp

# --- Langfuse Tracing (Optional) ---
# LLM Observability & Step Tracing
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_BASE_URL=http://localhost:3000
