# ==============================================================================
# {{ project_name }} - Frontend Environment Variables Sample (.env.sample)
# Copy this file to .env and configure your local frontend development variables:
#   $ cp .env.sample .env
#
# IMPORTANT:
# - Vite exposes variables prefixed with VITE_* to the client bundle.
#   NEVER put private secrets or API keys here!
# - For cookie/session authentication consistency, keep the hostname identical
#   between frontend and backend (e.g. localhost for both).
# ==============================================================================

# Application Branding Title
VITE_APP_TITLE="{{ project_name }}"

# Backend API Base URL used by the frontend API client.
#
# Option 1 (Default & Recommended for local dev): Same-origin proxy via Vite server
# Requests to /api are forwarded to VITE_DEV_PROXY_TARGET by Vite dev server.
VITE_API_BASE_URL=/api/v1
VITE_DEV_PROXY_TARGET=http://localhost:8000

# Option 2: Direct backend URL (cross-origin direct API access)
# If using direct backend calls, ensure CORS_ORIGINS in backend/.env allows your frontend port.
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# Admin Management SPA Route
VITE_ADMIN_URL=/admin.html
