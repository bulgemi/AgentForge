# ==============================================================================
# {{ project_name }} - Frontend Local Environment Variables (.env)
# Auto-generated by AgentForge CLI Scaffolding
# Note: Vite exposes VITE_* variables to the browser client bundle.
# ==============================================================================

# Application Branding
VITE_APP_TITLE="{{ project_name }}"

# Backend API Base Path (defaults to same-origin proxy via Vite dev server)
VITE_API_BASE_URL=/api/v1

# Vite Dev Server Proxy Target (forward /api requests to backend)
VITE_DEV_PROXY_TARGET=http://localhost:8000

# Admin SPA Route
VITE_ADMIN_URL=/admin.html
