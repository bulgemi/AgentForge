#!/usr/bin/env bash
# ==============================================================================
# AgentForge Project-Scoped Runner (macOS / Linux)
# Tailored for lifecycle operations inside a scaffolded project.
# Commands: sandbox, dev, build, deploy
# Disallows: new (scaffolding must be run outside an existing project)
# ==============================================================================

set -euo pipefail

BOLD='\033[1m'
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMAND="${1:-}"

# 1. Intercept 'new' command (disallowed inside an existing project)
if [ "$COMMAND" = "new" ]; then
    echo -e "${RED}${BOLD}[AgentForge Runner] 오류: './af new'는 생성된 프로젝트 내부에서 사용할 수 없습니다.${NC}"
    echo -e "${YELLOW}새로운 AI 에이전트 프로젝트를 생성하려면 프로젝트 디렉토리 외부에서 전역 'af new'를 사용하세요.${NC}"
    exit 1
fi

# 2. Project-scoped help message
if [ "$COMMAND" = "--help" ] || [ "$COMMAND" = "-h" ] || [ "$COMMAND" = "help" ] || [ -z "$COMMAND" ]; then
    echo -e "${CYAN}${BOLD}⚡ AgentForge Project Runner (./af)${NC}"
    echo "사용법: ./af <command> [options]"
    echo ""
    echo "사용 가능한 프로젝트 명령어:"
    echo "  sandbox   AWS EKS, GCP GKE, Azure AKS 및 로컬 K8s 온디맨드 샌드박스 관리 (up, watch, open, pause, resume, down)"
    echo "  dev       로컬 개발 서버 실행 (Backend + Frontend)"
    echo "  build     현재 프로젝트 Docker 컨테이너 이미지 빌드"
    echo "  deploy    현재 프로젝트 Kubernetes 클러스터 배포"
    echo ""
    echo "옵션:"
    echo "  -h, --help  도움말 표시"
    echo ""
    echo "💡 신규 프로젝트 생성('new')은 프로젝트 외부에서 전역 CLI 'af new'를 사용하세요."
    exit 0
fi

# 3. Dispatch lifecycle commands (sandbox, dev, build, deploy, etc.)
# Priority:
#   1. Global 'af' executable if installed on PATH
#   2. AGENTFORGE_CLI environment variable override
#   3. Local AgentForge development environment (sibling repo or virtualenv)
#   4. Active python environment where agentforge is installed
#   5. 'uvx' from official GitHub repository (avoiding 3rd-party PyPI package collision)
if command -v af >/dev/null 2>&1; then
    exec af "$@"
elif [ -n "${AGENTFORGE_CLI:-}" ] && [ -x "$AGENTFORGE_CLI" ]; then
    exec "$AGENTFORGE_CLI" "$@"
elif [ -f "$SCRIPT_DIR/../AgentForge/.venv/bin/af" ]; then
    exec "$SCRIPT_DIR/../AgentForge/.venv/bin/af" "$@"
elif [ -f "$SCRIPT_DIR/backend/.venv/bin/af" ]; then
    exec "$SCRIPT_DIR/backend/.venv/bin/af" "$@"
elif python3 -c "import agentforge" >/dev/null 2>&1; then
    exec python3 -m agentforge.cli.main "$@"
elif command -v uvx >/dev/null 2>&1; then
    exec uvx --from "git+https://github.com/bulgemi/AgentForge.git" af "$@"
fi

# 4. Fallback: Show helpful installation instructions
echo -e "${YELLOW}${BOLD}[AgentForge Runner] 'af' CLI를 실행할 수 없습니다.${NC}"
echo "다음 중 하나의 방법으로 AgentForge CLI를 실행할 수 있습니다:"
echo "  1) pip install -e <AgentForge 저장소 경로>  (로컬 개발 연동, 권장)"
echo "  2) uv tool install git+https://github.com/bulgemi/AgentForge.git (전역 설치)"
echo "  3) export PATH=\"/path/to/AgentForge/.venv/bin:\$PATH\""
exit 1
